class_name FusionWeapon
extends WeaponModule

## Shared combat implementation for data-configured fusion weapons.
const KNOCKBACK_WAVE := preload("res://Scripts/Modules/Fusion/FusionKnockbackWave.gd")
const SOUND_DIR := "res://Assets/Audio/Weapons/Fusion/"
## weapon_type_id -> [file, continuous, volume_db, max_polyphony].
## Generated by tools/generate_fusion_sfx.mjs. Shots play once per volley;
## *_loop sounds are held while the beam keeps ticking.
const SOUNDS := {
	&"scatter_machine_gun": ["scatter_machine_gun_shot.wav", false, -15.0, 2],
	&"knockback_machine_gun": ["knockback_machine_gun_shot.wav", false, -16.0, 2],
	&"laser_machine_gun": ["laser_machine_gun_shot.wav", false, -20.0, 3],
	&"sawblade_machine_gun": ["sawblade_machine_gun_shot.wav", false, -17.0, 2],
	&"flame_machine_gun": ["flame_machine_gun_shot.wav", false, -15.0, 2],
	&"laser_chainsaw": ["laser_chainsaw_loop.wav", true, -22.0, 1],
	&"heavy_laser": ["heavy_laser_loop.wav", true, -19.0, 1],
	&"automatic_cannon": ["automatic_cannon_shot.wav", false, -15.0, 3],
	&"siege_cannon": ["siege_cannon_shot.wav", false, -8.0, 2],
	&"knockback_cannon": ["knockback_cannon_shot.wav", false, -10.0, 2],
	&"flame_cannon": ["flame_cannon_shot.wav", false, -10.0, 2],
	&"knockback_laser": ["knockback_laser_shot.wav", false, -12.0, 2],
	&"flame_laser": ["flame_laser_loop.wav", true, -22.0, 1],
}
## How long a beam loop keeps sounding after its last damage tick.
const BEAM_SOUND_HOLD: float = 0.15

enum AttackKind { PROJECTILE, BEAM, WAVE }
enum VisualKind { SCATTER, KNOCKBACK, LASER, SAWBLADE, FLAME, CANNON }

@export var attack_kind: AttackKind = AttackKind.PROJECTILE
@export var visual_kind: VisualKind = VisualKind.SCATTER
@export var basic_damage: float = 5.0
@export var attack_interval: float = 0.2
@export var attack_range: float = 320.0
@export var projectile_range: float = 4.0
@export var projectile_speed: float = 450.0
@export var projectile_count: int = 1
@export var projectile_pierces_all_targets: bool = false
@export var spread_degrees: float = 0.0
@export var aoe_radius: float = 0.0
@export var knockback_distance: float = 0.0
@export var post_knockback_aoe_radius: float = 0.0
@export var post_knockback_damage_ratio: float = 0.0
@export var leaves_fire: bool = false
@export var fire_patch_duration: float = 3.0
@export var fire_patch_damage_ratio: float = 0.2
@export var fire_patch_radius: float = 42.0
@export var fire_patch_tick_interval: float = 0.5
@export var rotation_speed: float = 240.0
@export var aim_tolerance: float = 8.0
@export var beam_width: float = 6.0
@export var wave_thickness: float = 20.0
@export var wave_damage_per_second: float = 0.0
@export var projectile_scene: PackedScene

@onready var _turret: Node2D = $Turret
@onready var _muzzle: Marker2D = $Turret/Muzzle
@onready var _beam: Line2D = get_node_or_null("Turret/Muzzle/Beam") as Line2D

var current_target: BasicEnemy
var _cooldown: float = 0.0
var _visual_rotation: float = 0.0
var _sound: WeaponSound


func get_damage() -> float:
	return get_modified_damage(basic_damage)


func get_fire_rate() -> float:
	return get_modified_fire_rate(0.0 if attack_interval <= 0.0 else 1.0 / attack_interval)


func _ready() -> void:
	_build_sound()
	if _beam != null:
		_beam.hide()
		_update_beam()
	queue_redraw()


func _process(delta: float) -> void:
	_visual_rotation = fmod(_visual_rotation + delta * 8.0, TAU)
	queue_redraw()
	if assembly_mode:
		_deactivate()
		return
	var effective_range := get_modified_attack_range(attack_range)
	var aim_position: Vector2
	if is_manual_control_active():
		current_target = null
		aim_position = get_manual_aim_world_position()
		if not has_valid_manual_aim(_turret.global_position):
			_deactivate(false)
			return
	else:
		current_target = keep_or_find_target(current_target, _muzzle.global_position, effective_range, delta)
		if not is_instance_valid(current_target):
			_deactivate()
			return
		aim_position = current_target.get_target_point(global_position)
	rotate_turret_toward(_turret, aim_position, rotation_speed, delta)
	var allowed_error := maxf(deg_to_rad(aim_tolerance), 0.001)
	if get_aim_error(_turret, aim_position) > allowed_error:
		if _beam != null:
			_beam.hide()
		return
	var rate := get_fire_rate()
	if rate <= 0.0:
		return
	_cooldown -= delta
	if attack_kind == AttackKind.BEAM:
		_update_beam()
		_beam.show()
		while _cooldown <= 0.0:
			fire()
			_cooldown += 1.0 / rate
	elif _cooldown <= 0.0:
		fire()
		_cooldown = 1.0 / rate


func fire() -> void:
	_play_attack_sound()
	if attack_kind == AttackKind.BEAM:
		_fire_beam()
	elif attack_kind == AttackKind.WAVE:
		_fire_wave()
	else:
		_fire_projectiles()


func _fire_wave() -> void:
	var wave := KNOCKBACK_WAVE.new()
	wave.direction = Vector2.RIGHT.rotated(_muzzle.global_rotation)
	wave.speed = projectile_speed
	wave.maximum_distance = get_modified_attack_range(attack_range)
	wave.wave_length = get_modified_projectile_range(projectile_range)
	wave.wave_thickness = wave_thickness
	wave.initial_damage = get_damage()
	wave.damage_per_second = wave_damage_per_second
	wave.knockback_distance = knockback_distance
	wave.source_weapon = self
	get_tree().current_scene.add_child(wave)
	wave.global_position = _muzzle.global_position
	wave.arm_from_current_position()


func _fire_projectiles() -> void:
	if projectile_scene == null:
		push_error("FusionWeapon: projectile scene is missing.")
		return
	var count := maxi(projectile_count, 1)
	for index in range(count):
		var projectile := projectile_scene.instantiate() as FusionProjectile
		if projectile == null:
			push_error("FusionWeapon: projectile must extend FusionProjectile.")
			return
		get_tree().current_scene.add_child(projectile)
		projectile.global_position = _muzzle.global_position
		var offset := 0.0
		if count > 1:
			offset = deg_to_rad(lerpf(-spread_degrees, spread_degrees, float(index) / float(count - 1)))
		projectile.direction = Vector2.RIGHT.rotated(_muzzle.global_rotation + offset)
		projectile.damage = get_modified_explosion_damage(get_damage()) if aoe_radius > 0.0 else get_damage()
		projectile.speed = projectile_speed
		projectile.maximum_distance = get_modified_attack_range(attack_range)
		projectile.projectile_range = get_modified_projectile_range(projectile_range)
		projectile.pierces_all_targets = projectile_pierces_all_targets
		projectile.aoe_radius = aoe_radius
		projectile.knockback_distance = knockback_distance
		projectile.post_knockback_aoe_radius = post_knockback_aoe_radius
		projectile.post_knockback_damage_ratio = post_knockback_damage_ratio
		projectile.post_knockback_damage = get_modified_explosion_damage(get_damage()) * post_knockback_damage_ratio
		projectile.leaves_fire = leaves_fire
		projectile.fire_patch_duration = fire_patch_duration
		projectile.fire_patch_damage = get_damage() * fire_patch_damage_ratio
		projectile.fire_patch_radius = fire_patch_radius
		projectile.fire_patch_tick_interval = fire_patch_tick_interval
		projectile.visual_kind = visual_kind
		projectile.source_weapon = self
		var artifact_pierces := get_artifact_projectile_pierces()
		if artifact_pierces > 0:
			projectile.enable_ghost_piercing(artifact_pierces)
		projectile.arm_from_current_position()


func _fire_beam() -> void:
	var effective_range := get_modified_attack_range(attack_range)
	var shape := RectangleShape2D.new()
	shape.size = Vector2(effective_range, get_modified_projectile_range(beam_width))
	var direction := Vector2.RIGHT.rotated(_muzzle.global_rotation)
	var query := PhysicsShapeQueryParameters2D.new()
	query.shape = shape
	query.transform = Transform2D(_muzzle.global_rotation, _muzzle.global_position + direction * effective_range * 0.5)
	query.collision_mask = 1
	query.collide_with_areas = true
	query.collide_with_bodies = false
	var hit_ids: Dictionary = {}
	for result in get_world_2d().direct_space_state.intersect_shape(query, 256):
		var collider: Object = result.get("collider")
		if collider is Node and (collider as Node).is_in_group(&"destructible_props"):
			if not hit_ids.has(collider.get_instance_id()):
				hit_ids[collider.get_instance_id()] = true
				collider.call("take_damage", get_damage())
			continue
		var enemy := collider as BasicEnemy
		if enemy == null or enemy.is_dying() or not enemy.is_in_group(&"enemies"):
			continue
		if hit_ids.has(enemy.get_instance_id()):
			continue
		hit_ids[enemy.get_instance_id()] = true
		enemy.take_damage(get_damage(), false, true, self)


func _update_beam() -> void:
	if _beam == null:
		return
	_beam.width = get_modified_projectile_range(beam_width)
	_beam.points = PackedVector2Array([Vector2.ZERO, Vector2(get_modified_attack_range(attack_range), 0.0)])


func _deactivate(release_target: bool = true) -> void:
	if release_target:
		current_target = null
	_cooldown = 0.0
	if _beam != null:
		_beam.hide()


func _build_sound() -> void:
	var entry: Array = SOUNDS.get(weapon_type_id, [])
	if entry.is_empty():
		return
	var stream := load(SOUND_DIR + String(entry[0])) as AudioStream
	if stream == null:
		return
	_sound = WeaponSound.new()
	_sound.name = "Sound"
	_sound.continuous = bool(entry[1])
	_sound.stream = stream
	_sound.volume_db = float(entry[2])
	_sound.max_polyphony = int(entry[3])
	add_child(_sound)


## One shot per volley; beams keep their loop alive while ticks arrive.
func _play_attack_sound() -> void:
	if _sound == null:
		return
	if _sound.continuous:
		_sound.sustain_for(BEAM_SOUND_HOLD)
	else:
		_sound.play_shot()


func _draw() -> void:
	# The fused armoured base (static); the turret on top is FusionTurretVisual.
	FusionArt.draw_base(self, weapon_type_id, Palette.local_shadow_offset(self) * 0.6)


func _visual_color() -> Color:
	match visual_kind:
		VisualKind.KNOCKBACK:
			return Color("8D70D9")
		VisualKind.LASER:
			return Color("FFD06A")
		VisualKind.SAWBLADE:
			return Color("CBD0D0")
		VisualKind.FLAME:
			return Color("E34A2F")
		VisualKind.CANNON:
			return Palette.ACCENT
	return Color("E8D59B")
