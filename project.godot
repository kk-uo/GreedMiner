; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GreedMiner"
run/main_scene="res://Scenes/Base/base_main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

LanguageManager="*res://Scripts/Core/LanguageManager.gd"
AudioSettings="*res://Scripts/Core/AudioSettings.gd"
ProgressionStore="*res://Scripts/Core/ProgressionStore.gd"
WeaponUnlockManager="*res://Scripts/Progression/WeaponUnlockManager.gd"
ShipLoadout="*res://Scripts/Ship/ShipLoadout.gd"
ResourceManager="*res://Scripts/Core/ResourceManager.gd"
ResearchManager="*res://Scripts/Research/ResearchManager.gd"
ChipManager="*res://Scripts/Chips/ChipManagerV2.gd"
ArtifactManager="*res://Scripts/Artifacts/ArtifactManager.gd"
UiClickSound="*res://Scripts/Audio/UiClickSound.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=2560
window/size/window_height_override=1440
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[greedminer]

developer_mode/enabled=true

[gui]

theme/custom="res://Resources/UI/greedminer_theme.tres"

[internationalization]

locale/translations=PackedStringArray("res://Translations/zh_CN.po")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
