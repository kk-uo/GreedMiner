[resource]
script = ExtResource("1")
artifact_id = &"goblin_horn"
display_name = "Goblin Horn"
description = "The equipped weapon gains 1% fire rate for every 2000 actual damage and healing it deals during this battle. Resets after battle."
equip_target = 1
compatible_module_ids = Array[StringName]([&"machine_gun", &"dwarf_cannon", &"laser", &"chainsaw"])
acquisition_source = "Defeat the Goblin Giant Chariot"
