[sub_resource type="Resource" id="Chip_Attack"]
script = ExtResource("2_chip")
chip_id = &"attack_chip"
chip_name = "Power Chip"
description = "Adds 1 flat attack, shockwave, or healing power before percentage bonuses."
category_id = &"universal"
rarity_id = &"basic"
qualities = Array[ExtResource("4_quality")]([SubResource("Quality_Attack_Basic")])

[sub_resource type="Resource" id="Effect_AttackSpeed_Basic"]
