[sub_resource type="Resource" id="Effect_Attack_Basic"]
script = ExtResource("5_effect")
stat_id = &"damage"
adaptation_id = &"flat_attack"
flat_bonus = 1.0
effect_id = &"flat_damage"

[sub_resource type="Resource" id="Quality_Attack_Basic"]
script = ExtResource("4_quality")
