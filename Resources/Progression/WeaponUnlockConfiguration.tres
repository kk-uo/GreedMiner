[ext_resource type="Script" uid="uid://bum0yl1slohvx" path="res://Scripts/Progression/WeaponUnlockConfiguration.gd" id="2_configuration"]

[sub_resource type="Resource" id="MachineGun"]
script = ExtResource("1_definition")
weapon_id = &"machine_gun"
display_name = "Machine Gun"
unlock_condition = 0
requirement_text = "Available from the start."

[sub_resource type="Resource" id="DwarfCannon"]
